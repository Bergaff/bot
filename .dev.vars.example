# Скопируйте в .dev.vars (или задайте в окружении) для локального запуска.
# В проде (Cloudflare Worker) секреты — `wrangler secret put <NAME>`,
# несекретные значения — блок [vars] в wrangler.toml.

# ---- Существующие переменные проекта parcel (нужны для уведомлений админам) ----

# Токен бота от @BotFather — нужен, чтобы слать админам карточки новых заявок.
# Без него уведомления печатаются в лог (сбор при этом работает).
BOT_TOKEN=123456789:AAAA-ваш-токен

# ID администраторов через запятую — кому слать заявки на модерацию
ADMIN_IDS=123456789

# Токен админского API (watch-chats, collect, collect/status)
ADMIN_API_TOKEN=change-me-too

# Ключ DeepSeek: включает ИИ-ступень каскада для «трудных» объявлений.
# Без него работают только правила (src/parser.ts) — сбор не останавливается.
AI_API_KEY=
AI_MODEL=deepseek-chat

# ---- Вариант B: приём сообщений из браузерного расширения ----

# Bearer-токен для POST /api/ingest. ОТДЕЛЬНЫЙ от ADMIN_API_TOKEN:
# его можно отозвать, не теряя админ-доступ. Не задан → эндпоинт отвечает 503.
INGEST_TOKEN=change-me-ingest-token

# Сколько дней хранения у сообщений расширения (старше → skipped:too_old)
INGEST_MAX_AGE_DAYS=3

# ---- Вариант A: серверный сборщик публичных чатов ----

# "1" — cron-обход включён. Ручной POST /api/admin/collect работает и при "0".
COLLECT_ENABLED=1

# Сколько чатов обходим за один прогон (ротация: на бесплатном тарифе
# у воркера лимит ~50 подзапросов на вызов)
COLLECT_MAX_CHATS=10

# Сколько страниц ?before= на один чат за прогон
COLLECT_MAX_PAGES=2

# Сообщения старше N дней не берём
COLLECT_MAX_AGE_DAYS=7

# Жёсткий потолок сетевых запросов сборщика на один прогон
COLLECT_MAX_FETCHES=24

# Дневной лимит ИИ-вызовов авто-сбора (счётчик ai:collect:day:*).
# ОБЩИЙ ЛИМИТ БОТА (ai:day:*, 300) при этом не расходуется.
# По исчерпании разбор продолжается правилами.
COLLECT_AI_DAILY_LIMIT=100

# Зарезервировано: собранные заявки ВСЕГДА идут в pending (модерация).
COLLECT_AUTO_APPROVE=0

# Выражения cron — должны совпадать с [triggers] в wrangler.toml
COLLECT_CRON=17 */2 * * *
ARCHIVE_CRON=0 21 * * *

# ---- Только для локального запуска (в воркере не используются) ----

# Путь к локальной sqlite-базе (замена D1/KV)
COLLECT_DB=.data/collector.db
